# Neon PostgreSQL — replace with your actual credentials from neon.tech
# Pooled connection (used at runtime — pgBouncer-compatible)
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.us-east-1.aws.neon.tech/neondb?pgbouncer=true&connect_timeout=15&sslmode=require"

# Direct connection (used for prisma migrate / db push)
DIRECT_URL="postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require"
